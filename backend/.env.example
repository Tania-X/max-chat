# Auto-generated by `python -m app.shared.env_example`. Do not edit manually.
# JWT 签名密钥；留空则首次启动自动生成并持久化到 data/secrets.json（生产环境建议显式配置）
JWT_SECRET=
# JWT 签名算法，仅支持 HS256/HS384/HS512
JWT_ALGORITHM=HS256
# JWT 过期时间（分钟）
JWT_EXPIRE_MINUTES=10080
# Fernet 对称加密密钥（加密存储 API Key）；留空则首次启动自动生成并持久化到 data/secrets.json，生成命令：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# 数据库连接串
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# Google Gemini API Key（兜底模型 + 记忆抽取）
GOOGLE_API_KEY=
# OpenAI API Key（兜底）
OPENAI_API_KEY=
# 记忆/画像抽取用轻量模型
EXTRACTOR_MODEL=gemini-2.0-flash
# 允许的跨域来源
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
# 注入上下文的最近消息条数
CONTEXT_MESSAGE_LIMIT=50
